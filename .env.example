# Servidor
PORT=3000
ALLOWED_ORIGINS=

# Autenticacao do painel /config
ADMIN_USER=admin
ADMIN_PASS=troque_esta_senha
SESSION_SECRET=troque_por_uma_chave_longa_e_aleatoria

# Tipo de banco: mysql, postgres ou sqlserver
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=supermercado_db

# Consulta opcional. Quando vazia, o servidor usa a consulta padrao por tipo de banco.
# A consulta deve retornar: id, nome_produto, preco_anterior, preco_atual, link_imagem, data_validade
# Tambem pode retornar texto_validade.
DB_QUERY=

# Configuracoes visuais da tela
DISPLAY_TITLE=OFERTAS IMPERDIVEIS
DISPLAY_FOOTER_TEXT=Aproveite! Promocoes validas enquanto durarem os estoques.
DISPLAY_DEFAULT_LAYOUT=padrao
DISPLAY_FETCH_INTERVAL=30000
DISPLAY_CAROUSEL_INTERVAL=10000
DISPLAY_VITRINE_ITEM_INTERVAL=6000
DISPLAY_ITEMS_PADRAO=4
DISPLAY_ITEMS_COMPACTO=6
DISPLAY_ITEMS_VITRINE=5
DISPLAY_ITEMS_SEM_FOTO=4
DISPLAY_PRIMARY_COLOR=#d32f2f
DISPLAY_ACCENT_COLOR=#fbc02d
DISPLAY_BACKGROUND_COLOR=#111111
